{
  "name": "homebudgetai-fullstack",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20.19.0"
  },
  "packageManager": "npm@11.6.0",
  "scripts": {
    "dev": "npm --prefix frontend-react run dev",
    "start": "npm --prefix frontend-react run dev",
    "build": "npm --prefix frontend-react run build",
