{
  "installCommand": "npm ci --prefix frontend-react",
  "buildCommand": "node frontend-react/scripts/validate-production-api-url.mjs && npm run build --prefix frontend-react",
  "outputDirectory": "frontend-react/dist",
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
