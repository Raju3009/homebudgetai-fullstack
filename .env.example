# HomeBudgetAI configuration

# Frontend: local development default. Production builds must use the HTTPS URL below.
VITE_API_BASE_URL=http://localhost:5033/api
# Production deployment value (public configuration, not a secret):
# VITE_API_BASE_URL=https://homebudgetai-fullstack-2.onrender.com/api

# Backend
ASPNETCORE_ENVIRONMENT=Development
DatabaseProvider=Sqlite
ConnectionStrings__DefaultConnection=Data Source=homebudget-local.db
Jwt__Key=replace-with-a-long-random-256-bit-secret
Jwt__Issuer=HomeBudgetAI
Jwt__Audience=HomeBudgetAI.Users
Cors__AllowedOrigins__0=http://localhost:5173
SeedDemoData=true

# PostgreSQL example for Render
# DatabaseProvider=PostgreSQL
# ConnectionStrings__DefaultConnection=Host=host;Database=db;Username=user;Password=password;SSL Mode=Require;Trust Server Certificate=true
